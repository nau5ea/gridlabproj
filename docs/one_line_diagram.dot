digraph three_house_service {
    graph [rankdir=LR, splines=true, nodesep=0.45, ranksep=0.75, fontname="Helvetica"];
    node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#f7f7f7"];
    edge  [fontname="Helvetica", fontsize=9];

    source [label="7.2 kV primary source\n(swing node, phase C-N)", fillcolor="#d9e8f5"];
    xfmr   [label="Shared single-phase\ncenter-tapped transformer\n25 kVA, 7200 / 240-120 V\n(one of 10, 15, 25, 37.5 kVA)", fillcolor="#fce8c3"];
    bus    [label="Secondary bus\n240 / 120 V, 3-wire", fillcolor="#d9e8f5"];

    subgraph cluster_services {
        label="Three residential services (each load is downstream of its triplex meter)";
        fontname="Helvetica";
        fontsize=10;
        color="#bbbbbb";

        m1 [label="Triplex meter 1\nservice_meter_1", fillcolor="#e2f0d9"];
        m2 [label="Triplex meter 2\nservice_meter_2", fillcolor="#e2f0d9"];
        m3 [label="Triplex meter 3\nservice_meter_3", fillcolor="#e2f0d9"];

        h1 [label="house_1\nHVAC/appliances disabled", fillcolor="#eeeeee"];
        h2 [label="house_2\nHVAC/appliances disabled", fillcolor="#eeeeee"];
        h3 [label="house_3\nHVAC/appliances disabled", fillcolor="#eeeeee"];

        l1 [label="house_load_1\ntriplex_load\nhousehold demand player\n(excl. water heating)"];
        l2 [label="house_load_2\ntriplex_load\nhousehold demand player\n(excl. water heating)"];
        l3 [label="house_load_3\ntriplex_load\nhousehold demand player\n(excl. water heating)"];

        w1 [label="wh_1\nelectric water heater\n4.5 kW, 50 gal, 120 degF\nwater-draw player"];
        w2 [label="wh_2\nelectric water heater\n4.5 kW, 50 gal, 120 degF\nwater-draw player"];
        w3 [label="wh_3\nelectric water heater\n4.5 kW, 50 gal, 120 degF\nwater-draw player"];
    }

    source -> xfmr [label="primary"];
    xfmr -> bus [label="secondary"];
    bus -> m1 [label="50 ft triplex drop"];
    bus -> m2 [label="75 ft triplex drop"];
    bus -> m3 [label="100 ft triplex drop"];

    m1 -> l1;
    m2 -> l2;
    m3 -> l3;
    m1 -> h1 [style=dashed];
    m2 -> h2 [style=dashed];
    m3 -> h3 [style=dashed];
    h1 -> w1;
    h2 -> w2;
    h3 -> w3;

    note [shape=note, fillcolor="#fff8dc", label="Measurement boundary used for transformer loading:\nxfmr.power_in (primary input).\nService meters measure combined triplex load + water heater.\nDashed line = thermal host house, no HVAC/appliance load."];
    note -> xfmr [style=dotted, arrowhead=none];
}
